# --- Decision model (Jev) -----------------------------------------------------
# Option A: Vercel AI Gateway. Put the vck_ key in TYPESAFE_API_KEY even though it is
# a Vercel key; the gateway carries the model id in a transport header instead.
JEV_GATEWAY_URL=https://ai-gateway.vercel.sh
JEV_MODEL_ID=typesafe-ai/jev
TYPESAFE_API_KEY=

# Option B: native TypeSafe API. Leave JEV_GATEWAY_URL empty and use a TypeSafe key.
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_MODEL=jev-latest

# --- Text helper (required for TYPE_TEXT) -------------------------------------
# Any OpenAI-compatible endpoint. The Vercel gateway works with the same vck_ key.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
